{
  "name": "upnology",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:api && npm run typecheck && vite build",
    "build:api": "tsc -p tsconfig.function.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "node --import tsx --test --experimental-test-isolation=none tests/*.test.ts",
    "dev:api": "node --import tsx --env-file-if-exists=.env.local server/dev.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/functions": "3.10.1",
    "pdf-lib": "1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "23.0.0",
    "three": "^0.180.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "^9.36.0",
    "@types/node": "22.20.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": "22.x"
  }
}
