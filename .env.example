VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PUBLIC_EMAIL=
VITE_PUBLIC_PHONE=
VITE_PUBLIC_WHATSAPP=

# Server only: never prefix these variables with VITE_.
# All integrations are OFF by default. The public site can deploy without them.
COMMERCIAL_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Preferred server-only key (sb_secret_); never use a VITE_ prefix.
SUPABASE_SECRET_KEY=
# Legacy fallback only when SUPABASE_SECRET_KEY is empty or absent.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical HTTPS origin, e.g. https://your-domain.example (no path).
APP_URL=https://upnology.agency

STRIPE_ENABLED=false
STRIPE_MODE=live
# Server secret or restricted key; prefix must match STRIPE_MODE.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional test invoices ONLY; rejected in live mode. Keep fixed while attempts are open.
STRIPE_SANDBOX_INVOICES=false
# Reserved gate: true blocks Checkout until quote-level fiscal integration is implemented.
STRIPE_TAX_ENABLED=false

RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
# Generate a random secret of at least 32 characters for the cron endpoint.
CRON_SECRET=
# Comma-separated HTTPS origins with independently enforced customer access.
# Empty means demo/delivery links cannot be opened through the application.
DEMO_ALLOWED_ORIGINS=
